{
  "manifest_version": 3,
  "name": "Magic Number Extensions",
  "description": "This extension injects a magic number to pages",
  "version": "1.0.0",
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "magic-number-extension@playwright-webextext.test"
    }
  }
}
